# ============================================
# Application Settings
# ============================================
APP_NAME=AI Resume Screener
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# API Settings
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# ============================================
# Database Configuration
# ============================================
# SQLite (for development)
DATABASE_URL=sqlite:///./resume_screening.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/resume_screening
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=resume_screening
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ============================================
# Google Calendar API
# ============================================
GOOGLE_CALENDAR_ENABLED=False
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google_calendar.json
GOOGLE_CALENDAR_TOKEN_PATH=./credentials/token.pickle
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar

# ============================================
# Microsoft Graph API (Outlook Calendar)
# ============================================
MICROSOFT_CALENDAR_ENABLED=False
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_TENANT_ID=your_tenant_id_here
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@resumescreener.com
EMAIL_FROM_NAME=AI Resume Screener

# ============================================
# AI/ML Model Settings
# ============================================
# AI Provider: 'azure' or 'openai' or 'local'
AI_PROVIDER=azure

# Azure OpenAI Configuration
AZURE_OPENAI_ENABLED=True
AZURE_OPENAI_ENDPOINT=https://itcmentor.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI - Text Embeddings
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_MODEL=text-embedding-3-large
AZURE_EMBEDDING_DIMENSION=3072

# Azure OpenAI - GPT-4o-mini (for matching explanations)
AZURE_GPT_DEPLOYMENT=gpt-4o-mini
AZURE_GPT_MODEL=gpt-4o-mini
AZURE_GPT_API_VERSION=2024-12-01-preview

# Local Sentence Transformer Model (fallback)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Alternative models:
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Vector Database
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./data/vector_db
VECTOR_DB_DIMENSION=3072

# Resume Parsing
SPACY_MODEL=en_core_web_sm
MAX_RESUME_SIZE_MB=10

# Matching Thresholds
MIN_MATCH_SCORE=0.5
TOP_CANDIDATES_COUNT=10

# ============================================
# Naukri API (Resdex) Configuration
# ============================================
# NOTE: Naukri API access not available
# Using synthetic sample data instead (see data/sample_resumes/ and data/sample_jds/)
NAUKRI_API_ENABLED=False
# NAUKRI_API_KEY=not_available
# NAUKRI_API_SECRET=not_available
# NAUKRI_BASE_URL=https://api.naukri.com
# NAUKRI_TIMEOUT=30

# ============================================
# Sample Data Configuration
# ============================================
# Use synthetic data for testing and demonstration
USE_SAMPLE_DATA=True
SAMPLE_RESUMES_DIR=./data/sample_resumes
SAMPLE_JDS_DIR=./data/sample_jds

# ============================================
# Redis Configuration (for Celery)
# ============================================
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# Telegram Bot (Optional)
# ============================================
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# ============================================
# WhatsApp Integration (Optional)
# ============================================
WHATSAPP_ENABLED=False
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ============================================
# Scheduler Settings
# ============================================
# Interview duration in minutes
DEFAULT_INTERVIEW_DURATION=60

# Buffer time between interviews (minutes)
INTERVIEW_BUFFER_TIME=15

# Working hours (24-hour format)
WORKING_HOURS_START=09:00
WORKING_HOURS_END=18:00

# Working days (comma-separated: 0=Monday, 6=Sunday)
WORKING_DAYS=0,1,2,3,4

# Timezone
TIMEZONE=Asia/Kolkata

# ============================================
# Notification Settings
# ============================================
# Send notifications
NOTIFICATIONS_ENABLED=True

# Reminder settings
SEND_INTERVIEW_REMINDERS=True
REMINDER_BEFORE_HOURS=24,2

# Confirmation emails
SEND_CONFIRMATION_EMAILS=True
SEND_REJECTION_EMAILS=False

# ============================================
# File Upload Settings
# ============================================
UPLOAD_DIR=./data/resumes
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.doc,.docx

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# ============================================
# Security Settings
# ============================================
# JWT Token
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Frontend Settings
# ============================================
FRONTEND_URL=http://localhost:8501
STREAMLIT_SERVER_PORT=8501

# ============================================
# Development/Testing
# ============================================
TESTING=False
MOCK_EXTERNAL_APIS=False
USE_SAMPLE_DATA=True

# ============================================
# Performance Settings
# ============================================
# Number of worker processes
WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Maximum concurrent connections
MAX_CONNECTIONS=100

# Cache settings
CACHE_ENABLED=True
CACHE_TTL=3600
